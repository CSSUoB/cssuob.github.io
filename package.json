{
  "devDependencies": {
    "@cspell/dict-en-gb": "^4.1.52",
    "@eslint/js": "^9.17.0",
    "cspell": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-plugin-html": "^8.1.2",
    "globals": "^15.14.0",
    "markdownlint": "^0.37.2",
    "markdownlint-cli": "^0.46.0",
    "prettier": "3.2.5"
  },
  "scripts": {
    "lint": "npm run lint:js && npm run lint:md",
    "lint:js": "eslint",
    "lint:md": "markdownlint -c .markdownlint.jsonc -p .gitignore .",
    "lint:fix": "eslint --fix && markdownlint -c .markdownlint.jsonc -p .gitignore --fix .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "spellcheck": "cspell --gitignore '**/*.{md,html}'",
    "spellcheck:staged": "git diff HEAD --name-only --diff-filter=d -- '*.md' '*.html' | cspell --file-list stdin --no-must-find-files"
  }
}
